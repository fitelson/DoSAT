{
  "name": "dosat",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "copy-files": "cp node_modules/z3-solver/build/z3-built.js node_modules/z3-solver/build/z3-built.wasm public",
    "build": "npm run copy-files && tsc && vite build",
    "lint": "eslint src tests *.config.ts --max-warnings=0",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test:unit": "vitest --run",
    "test:e2e": "npm run test:e2e:dosat",
    "test": "npm run test:unit && npm run test:e2e",
    "test-single": "vitest --allowOnly",
    "deploy": "node scripts/deploy-disabled.mjs",
    "prepare:release": "npm run build && node scripts/prepare-dosat-release.mjs",
    "postinstall": "node scripts/install-lint-toolchain.mjs",
    "test:e2e:dosat": "playwright test --project=chromium tests/causal_decision.spec.ts tests/causal_literature_examples.spec.ts",
    "test:e2e:legacy": "playwright test --project=chromium tests/simple.spec.ts tests/causal.spec.ts tests/do_calculus.spec.ts",
    "test:e2e:all": "playwright test --project=chromium"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.5",
    "@types/parsimmon": "^1.10.9",
    "eslint": "10.12.0",
    "jsdom": "30.1.2",
    "playwright": "1.64.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "parsimmon": "^1.18.1",
    "z3-solver": "^5.2.0"
  },
  "packageManager": "npm@12.2.0",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  }
}
